{
  "name": "blogsmith",
  "version": "0.1.0",
  "description": "Smart SEO editor + one-click publisher for free .blogspot.com blogs (Blogger API v3)",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "build": "esbuild client/app.js --bundle --format=iife --outfile=client/bundle.js",
    "start": "node server/index.js",
    "dev": "npm run build && node server/index.js",
    "test": "node --test 'tests/*.test.js'"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "esbuild": "^0.28.2"
  }
}
