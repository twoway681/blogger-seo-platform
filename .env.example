# --- Server ---
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# --- Provider: "fake" (offline demo, default) or "google" (real Blogger API v3) ---
# Without Google credentials the app automatically falls back to the fake provider.
PROVIDER=fake

# --- Google OAuth 2.0 (only needed for PROVIDER=google) ---
# Create in Google Cloud Console: enable Blogger API v3 + Search Console API,
# OAuth consent screen, then OAuth client (type: Web application) with
# authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Publishing safety ---
# dry_run (default): build and validate the full Blogger payload but never send it live.
# live: actually call the Blogger API. Requires PROVIDER=google AND explicit owner approval.
PUBLISH_MODE=dry_run

# --- Image storage: "local" (default, serves /uploads from disk) ---
# Production equivalent documented in README: Cloudflare R2 / Cloudinary / S3+CloudFront.
IMAGE_STORAGE=local
